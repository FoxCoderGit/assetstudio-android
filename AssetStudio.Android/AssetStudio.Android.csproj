<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AssetStudio.AndroidApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.codebyfox.assetstudio.dotnet</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <UseInterpreter>false</UseInterpreter>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <AndroidUseDebugRuntime>false</AndroidUseDebugRuntime>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetStudio-0.16.47\AssetStudio\AssetStudio.csproj" />
    <ProjectReference Include="..\AssetStudio-0.16.47\AssetStudioUtility\AssetStudioUtility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.0.1.33" />
    <PackageReference Include="Fmod5Sharp" Version="2.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

</Project>
